{
  "name": "Job Tracker weekly notifications v1",
  "active": false,
  "nodes": [
    {
      "id": "schedule",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 200],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 8 * * 1"
            }
          ]
        }
      }
    },
    {
      "id": "fetch",
      "name": "Fetch notifications",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 200],
      "parameters": {
        "url": "https://jtrackerch.runasp.net/api/internal/digest/weekly",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_IN_N8N",
          "name": "Job Tracker automation key"
        }
      }
    },
    {
      "id": "prepare",
      "name": "Prepare notifications",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 200],
      "parameters": {
        "jsCode": "return $input.all().flatMap((item,index) => (Array.isArray(item.json)?item.json:[item.json]).map(row => ({json:{userId:row.userId,email:row.email,deliveryKey:row.deliveryKey,subject:'Weekly application digest',text:JSON.stringify({newThisWeek:row.newThisWeek,activeTotal:row.activeTotal,statusChanges:row.statusChanges})},pairedItem:{item:index}})));"
      }
    },
    {
      "id": "claim",
      "name": "Claim delivery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 200],
      "parameters": {
        "method": "POST",
        "url": "https://jtrackerch.runasp.net/api/internal/notifications/claim",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({userId:$json.userId,deliveryKey:$json.deliveryKey}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_IN_N8N",
          "name": "Job Tracker automation key"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "allowed",
      "name": "Delivery allowed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 200],
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.leaseToken }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "email",
      "name": "Send email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 200],
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $('Prepare notifications').item.json.deliveryKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({from:'CONFIGURE_VERIFIED_SENDER',to:[$('Prepare notifications').item.json.email],subject:$('Prepare notifications').item.json.subject,text:$('Prepare notifications').item.json.text}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_EMAIL_CREDENTIAL",
          "name": "Reminder email provider bearer key"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "accepted",
      "name": "Email accepted",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1320, 200],
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.id }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "complete",
      "name": "Complete delivery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 200],
      "parameters": {
        "method": "POST",
        "url": "https://jtrackerch.runasp.net/api/internal/notifications/complete",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({deliveryKey:$('Claim delivery').item.json.deliveryKey,leaseToken:$('Claim delivery').item.json.leaseToken}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_IN_N8N",
          "name": "Job Tracker automation key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "id": "done",
      "name": "Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1760, 200],
      "parameters": {}
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Fetch notifications",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch notifications": {
      "main": [
        [
          {
            "node": "Prepare notifications",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare notifications": {
      "main": [
        [
          {
            "node": "Claim delivery",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim delivery": {
      "main": [
        [
          {
            "node": "Delivery allowed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Delivery allowed": {
      "main": [
        [
          {
            "node": "Send email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send email": {
      "main": [
        [
          {
            "node": "Email accepted",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email accepted": {
      "main": [
        [
          {
            "node": "Complete delivery",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Complete delivery": {
      "main": [
        [
          {
            "node": "Done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC",
    "executionTimeout": 240,
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false
  },
  "pinData": {},
  "tags": []
}
