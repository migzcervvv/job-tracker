# Local containers only. Copy to .env and generate fresh secrets.
POSTGRES_PASSWORD=local-development-only
JWT_KEY=replace-with-at-least-32-random-bytes
AUTOMATION_KEY=replace-with-a-different-random-secret
N8N_ENCRYPTION_KEY=replace-with-a-third-random-secret
BOOTSTRAP_EMAIL=admin@example.test
BOOTSTRAP_PASSWORD=LocalAdminPassword123
# Tested workflow schema target; upgrade explicitly after the contract suite.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.42.3
PARSER_API_KEY=replace-with-a-fourth-random-secret
SUPABASE_DOWNLOAD_HOST=YOUR_PROJECT.supabase.co
# Optional: real private resume storage. Leave blank for database-only development.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Optional: ephemeral demo account. Generate its password locally.
DEMO_EMAIL=
DEMO_PASSWORD=
